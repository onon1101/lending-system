<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <PackageReference Include="MediatR" Version="14.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="Minio" Version="7.0.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.*" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LendingSystem.Auth.ACL\LendingSystem.Auth.ACL.csproj" />
    <ProjectReference Include="..\LendingSystem.Auth.Application\LendingSystem.Auth.Application.csproj" />
    <ProjectReference Include="..\LendingSystem.Auth.Infrastructure\LendingSystem.Auth.Infrastructure.csproj" />
    <ProjectReference Include="..\LendingSystem.Auth.WebApi\LendingSystem.Auth.WebApi.csproj" />
    <ProjectReference Include="..\LendingSystem.Lending.Application\LendingSystem.Lending.Application.csproj" />
    <ProjectReference Include="..\LendingSystem.Lending.Infrastructure\LendingSystem.Lending.Infrastructure.csproj" />
    <ProjectReference Include="..\LendingSystem.Lending.WebApi\LendingSystem.Lending.WebApi.csproj" />
    <ProjectReference Include="..\LendingSystem.SharedKernel.Application\LendingSystem.SharedKernel.Application.csproj" />
    <ProjectReference Include="..\LendingSystem.SharedKernel.Domain\LendingSystem.SharedKernel.Domain.csproj" />
    <ProjectReference Include="..\LendingSystem.SharedKernel.Infrastructure\LendingSystem.SharedKernel.Infrastructure.csproj" />
    <ProjectReference Include="..\LendingSystem.SharedKernel.WebApi\LendingSystem.SharedKernel.WebApi.csproj" />
  </ItemGroup>

</Project>
