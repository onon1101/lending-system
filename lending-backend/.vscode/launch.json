  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Package",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/server",
      "cwd": "${workspaceFolder}/",
      "env": {
        // 不要覺得 .env 上傳上來很毒瘤，反正這個專案拿來玩的，不要計較那麼多。
        "APP_PORT": "8000",

        // 資料庫連線資訊 (如果您的 DB 服務在本地運行，請確保這些資訊正確)
        "DB_HOST": "192.168.2.110",
        "DB_PORT": "5432",
        "DB_USER": "lending_user",
        "DB_PASSWORD": "mypassword",
        "DB_NAME": "lending_db_dev",

        "MINIO_ENDPOINT": "192.168.2.110:9000",
        "MINIO_ACCESS_KEY": "minio_user",
        "MINIO_SECRET_KEY": "minio_password",
        "MINIO_BUCKET_NAME": "lending-images"
      }
    }
  ]
}
